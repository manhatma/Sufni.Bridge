<UserControl
    x:Class="Sufni.Bridge.Views.SessionPages.MiscPageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:Sufni.Bridge.Views.Controls"
    xmlns:models="clr-namespace:Sufni.Bridge.Models"
    xmlns:vm="clr-namespace:Sufni.Bridge.ViewModels.SessionPages"
    d:DesignHeight="600"
    d:DesignWidth="500"
    x:DataType="vm:MiscPageViewModel"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:MiscPageViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Button.pan-nudge">
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource SufniForeground}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer Width="{Binding $parent[ScrollViewer].Bounds.Width}" Height="{Binding $parent[ScrollViewer].Bounds.Height}" IsScrollChainingEnabled="False">
        <StackPanel Orientation="Vertical">
            <ComboBox Margin="0,0,0,8"
                      HorizontalAlignment="Stretch"
                      IsVisible="{Binding TrackMap, Converter={x:Static ObjectConverters.IsNotNull}}"
                      ItemsSource="{Binding OverlayMetrics}"
                      SelectedItem="{Binding SelectedOverlayMetric, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:TrackOverlayMetricOption">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Image Margin="0,0,0,8"
                   MinHeight="220"
                   Stretch="Uniform"
                   IsVisible="{Binding TrackMap, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Source="{Binding TrackMap}" />
            <Grid Margin="0,0,0,8"
                  ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto"
                  IsVisible="{Binding TrackOffsetAvailable}">
                <Button Grid.Column="0"
                        Classes="pan-nudge"
                        Command="{Binding NudgeTrackOffsetCommand}"
                        CommandParameter="{x:Static vm:MiscPageViewModel.NudgeMinus5000}"
                        Content="-5 s" />
                <Button Grid.Column="1"
                        Classes="pan-nudge"
                        Command="{Binding NudgeTrackOffsetCommand}"
                        CommandParameter="{x:Static vm:MiscPageViewModel.NudgeMinus1000}"
                        Content="-1 s" />
                <TextBlock Grid.Column="2"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="{Binding TrackTimeOffsetLabel}" />
                <Button Grid.Column="3"
                        Classes="pan-nudge"
                        Command="{Binding NudgeTrackOffsetCommand}"
                        CommandParameter="{x:Static vm:MiscPageViewModel.NudgePlus1000}"
                        Content="+1 s" />
                <Button Grid.Column="4"
                        Classes="pan-nudge"
                        Command="{Binding NudgeTrackOffsetCommand}"
                        CommandParameter="{x:Static vm:MiscPageViewModel.NudgePlus5000}"
                        Content="+5 s" />
                <Button Grid.Column="5"
                        Classes="pan-nudge"
                        Command="{Binding AutoTrackOffsetCommand}"
                        Content="Auto" />
                <Button Grid.Column="6"
                        Classes="pan-nudge"
                        Command="{Binding ResetTrackOffsetCommand}"
                        Content="Reset" />
            </Grid>
            <Image IsVisible="{Binding PositionVelocityComparison, Converter={x:Static ObjectConverters.IsNotNull}}" Source="{Binding PositionVelocityComparison}" />
            <Image IsVisible="{Binding FrontPositionVelocity, Converter={x:Static ObjectConverters.IsNotNull}}" Source="{Binding FrontPositionVelocity}" />
            <Image IsVisible="{Binding RearPositionVelocity, Converter={x:Static ObjectConverters.IsNotNull}}" Source="{Binding RearPositionVelocity}" />
            <!--  Combined front+rear acceleration — shown only while zoomed, replaces the two separate plots below  -->
            <Image IsVisible="{Binding CombinedAccelerationTimeZoomed, Converter={x:Static ObjectConverters.IsNotNull}}" Source="{Binding CombinedAccelerationTimeZoomed}" />
            <Image IsVisible="{Binding FrontAccelerationTimeCropped, Converter={x:Static ObjectConverters.IsNotNull}}" Source="{Binding FrontAccelerationTimeCropped}" />
            <Image IsVisible="{Binding RearAccelerationTimeCropped, Converter={x:Static ObjectConverters.IsNotNull}}" Source="{Binding RearAccelerationTimeCropped}" />

            <!--  Session-wide time-zoom (shared instance across Spring/Damper/Misc)  -->
            <controls:TimeZoomControl DataContext="{Binding TimeZoom}" MiniMap="{Binding MiniMapAcceleration}" IsVisible="{Binding IsEnabled, FallbackValue=False}" />
        </StackPanel>
    </ScrollViewer>

</UserControl>
