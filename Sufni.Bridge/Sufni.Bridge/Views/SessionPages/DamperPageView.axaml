<UserControl
    x:Class="Sufni.Bridge.Views.SessionPages.DamperPageView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:plots="clr-namespace:Sufni.Bridge.Views.Plots"
    xmlns:controls="clr-namespace:Sufni.Bridge.Views.Controls"
    xmlns:vm="clr-namespace:Sufni.Bridge.ViewModels.SessionPages"
    d:DesignHeight="600"
    d:DesignWidth="500"
    x:DataType="vm:DamperPageViewModel"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:DamperPageViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="ToggleSwitch.histoToggle">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,6,20,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#9AA5AD" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer Width="{Binding $parent[ScrollViewer].Bounds.Width}" Height="{Binding $parent[ScrollViewer].Bounds.Height}" IsScrollChainingEnabled="False">
        <StackPanel Orientation="Vertical">
            <!--  Velocity distribution comparison  -->
            <Image IsVisible="{Binding VelocityDistributionComparison, Converter={x:Static ObjectConverters.IsNotNull}}" Source="{Binding VelocityDistributionComparison}" />

            <ToggleSwitch Classes="histoToggle" IsChecked="{Binding PowerMode}" OnContent="power ∝ v²·t" OffContent="time" />
            <ToggleSwitch Classes="histoToggle" IsChecked="{Binding PowerLogMode}" OnContent="log Y" OffContent="lin Y" IsVisible="{Binding PowerMode}" />
            <!--  Front velocity histogram  -->
            <Image IsVisible="{Binding EffectiveFrontVelocityHistogram, Converter={x:Static ObjectConverters.IsNotNull}}" Source="{Binding EffectiveFrontVelocityHistogram}" />

            <!--  Rear velocity histogram  -->
            <Image IsVisible="{Binding EffectiveRearVelocityHistogram, Converter={x:Static ObjectConverters.IsNotNull}}" Source="{Binding EffectiveRearVelocityHistogram}" />

            <!--  Front low-speed velocity histogram with zone breakdown  -->
            <ToggleSwitch Classes="histoToggle" IsChecked="{Binding LogMode}" OnContent="log" OffContent="linear" />
            <StackPanel IsVisible="{Binding EffectiveFrontLowSpeedVelocityHistogram, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Image Source="{Binding EffectiveFrontLowSpeedVelocityHistogram}" />
                <plots:VelocityBandView
                    Margin="50,0,20,0"
                    Title="Front Zone %"
                    HscPercentage="{Binding FrontHscPercentage}"
                    HsrPercentage="{Binding FrontHsrPercentage}"
                    LscPercentage="{Binding FrontLscPercentage}"
                    LsrPercentage="{Binding FrontLsrPercentage}" />
            </StackPanel>

            <!--  Rear low-speed velocity histogram with zone breakdown  -->
            <StackPanel IsVisible="{Binding EffectiveRearLowSpeedVelocityHistogram, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,16,0,0">
                <Image Source="{Binding EffectiveRearLowSpeedVelocityHistogram}" />
                <plots:VelocityBandView
                    Margin="50,0,20,0"
                    Title="Rear Zone %"
                    HscPercentage="{Binding RearHscPercentage}"
                    HsrPercentage="{Binding RearHsrPercentage}"
                    LscPercentage="{Binding RearLscPercentage}"
                    LsrPercentage="{Binding RearLsrPercentage}" />
            </StackPanel>

            <!--  Rear shaft velocity histogram (damper domain)  -->
            <ToggleSwitch Classes="histoToggle" IsChecked="{Binding PowerMode}" OnContent="power ∝ v²·t" OffContent="time" />
            <ToggleSwitch Classes="histoToggle" IsChecked="{Binding PowerLogMode}" OnContent="log Y" OffContent="lin Y" IsVisible="{Binding PowerMode}" />
            <Image IsVisible="{Binding EffectiveRearDamperVelocityHistogram, Converter={x:Static ObjectConverters.IsNotNull}}" Source="{Binding EffectiveRearDamperVelocityHistogram}" Margin="0,16,0,0" />

            <!--  Combined front+rear velocity — shown only while zoomed, replaces the two separate plots below  -->
            <Image IsVisible="{Binding CombinedVelocityTimeZoomed, Converter={x:Static ObjectConverters.IsNotNull}}" Source="{Binding CombinedVelocityTimeZoomed}" />
            <Image IsVisible="{Binding FrontVelocityTimeCropped, Converter={x:Static ObjectConverters.IsNotNull}}" Source="{Binding FrontVelocityTimeCropped}" />
            <Image IsVisible="{Binding RearVelocityTimeCropped, Converter={x:Static ObjectConverters.IsNotNull}}" Source="{Binding RearVelocityTimeCropped}" />

            <!--  Session-wide time-zoom (shared instance across Spring/Damper/Misc)  -->
            <controls:TimeZoomControl DataContext="{Binding TimeZoom}" MiniMap="{Binding MiniMapVelocity}" IsVisible="{Binding IsEnabled, FallbackValue=False}" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
